{
  "version": 1,
  "runtimes": [
    {
      "name": "example-runtime",
      "enabled": true,
      "event_containers": ["example-gateway", "example-service"],
      "health": {
        "checks": [
          {
            "container": "example-gateway",
            "require_healthy": true,
            "required_files": []
          },
          {
            "container": "example-service",
            "require_healthy": false,
            "required_files": ["/run/example-secrets/api_key"]
          }
        ]
      },
      "recovery": {
        "script": "C:\\path\\to\\project\\recover.ps1",
        "arguments": ["up"],
        "working_directory": "C:\\path\\to\\project"
      },
      "cooldown_seconds": 30
    }
  ]
}
